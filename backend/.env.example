# --- Application ---
# blank spaces not allowed
APP_TITLE="MyAPI"
APP_DESCRIPTION="A simple API"

# dev or prod 
APP_MODE=dev

APP_HOST=127.0.0.1
APP_PORT=8000

# a list, with "," separator or *, for any
APP_ALLOW_IPS="*"

# should starts with "/"
APP_SUB_PATH="/api/v1" 

# --- Database ---
DATABASE_CONNECTION_URL="postgresql://my_user:my_secure_password@localhost:5432/my_database"
